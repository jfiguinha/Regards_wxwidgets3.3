//
// To Optimize : https://zz85.github.io/glsl-optimizer/
//

#version 330 core

in vec2 TexCoord;
in float CurlAmount;

uniform sampler2D sourceTex;

out vec4 FragColor;

void main() 
{
	vec4 color;

	/*
	* La face avant utilise directement la texture source.
	*
	* La face arrière utilise la même texture avec les
	* coordonnées X inversées afin que le verso soit
	* correctement orienté.
	*/

	if (gl_FrontFacing) 
	{
		color = texture(sourceTex, TexCoord);
	} 
	else 
	{
		vec2 backTexCoord = vec2(1.0 - TexCoord.x, TexCoord.y);

		color = texture(sourceTex, backTexCoord);

		/*
		 * Aspect du verso de la page.
		 */
		float gray = dot(color.rgb, vec3(0.3333333, 0.3333333, 0.3333333));

		/*
		 * On conserve une petite quantité de la couleur
		 * originale afin d'éviter un verso totalement gris.
		 */
		color.rgb = mix(vec3(gray), color.rgb, 0.15);
	}

	/*
	* Ombre progressive sur la partie retournée.
	*
	* CurlAmount est calculé dans C++ pour chaque sommet
	* puis interpolé automatiquement par OpenGL.
	*/
	float shadow = CurlAmount * 0.20;

	/*
	* Le verso est légèrement plus sombre.
	*/
	if (!gl_FrontFacing) {
		shadow += 0.15;
	}

	color.rgb *= 1.0 - shadow;

	FragColor = color;
}

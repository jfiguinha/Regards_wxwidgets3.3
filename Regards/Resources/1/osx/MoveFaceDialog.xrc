<?xml version="1.0" encoding="utf-8" ?>
<resource xmlns="http://wxwidgets.org">
	<object class="wxDialog" name="MoveFaceDialog">
		<title>Select a new Face Name</title>
		<centered>1</centered>
		<size>470,160</size>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<!-- Face Name Input -->
			<object class="sizeritem">
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					<!-- Face Name Label -->
					<object class="sizeritem">
						<flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
						<border>5</border>
						<size>100,-1</size>
						<object class="wxStaticText" name="ID_STATICTEXT1">
							<label>Face Name</label>
						</object>
					</object>
					<!-- Text Control -->
					<object class="sizeritem">
						<flag>wxEXPAND|wxALL</flag>
						<border>5</border>
						<object class="wxComboBox" name="ID_CBLISTFACE">
							<size>170,20</size>
							<value>List Face</value>
						</object>
					</object>
				</object>
			</object>
			<!-- OK and Cancel Buttons -->
			<object class="sizeritem">
				<flag>wxALIGN_CENTER|wxALL</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					<object class="sizeritem">
						<flag>wxALIGN_CENTER|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="ID_OK">
							<label>OK</label>
						</object>
					</object>
					<object class="sizeritem">
						<flag>wxALIGN_CENTER|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="ID_CANCEL">
							<label>Cancel</label>
						</object>
					</object>
				</object>
			</object>
		</object>
	</object>
</resource>

<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://wxwidgets.org">
    <object class="wxDialog" name="ID_LAYER_PROPERTIES_DIALOG">
        <title>Propriétés du calque</title>
        <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>
        
        <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>

            <!-- 1. ENVELOPPE AJOUTÉE : Nom du calque -->
            <object class="sizeritem">
                <flag>wxEXPAND|wxALL</flag>
                <border>8</border>
                <object class="wxStaticBoxSizer">
                    <orient>wxVERTICAL</orient>
                    <label>Calque</label>
                    <object class="sizeritem">
                        <flag>wxEXPAND</flag>
                        <object class="wxTextCtrl" name="ID_LAYER_NAME">
                            <size>350,-1</size>
                        </object>
                    </object>
                </object>
            </object>

            <!-- 2. ENVELOPPE AJOUTÉE : Mode de fusion -->
            <object class="sizeritem">
                <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
                <border>8</border>
                <object class="wxStaticBoxSizer">
                    <orient>wxVERTICAL</orient>
                    <label>Mode de fusion</label>
                    <object class="sizeritem">
                        <flag>wxEXPAND</flag>
                        <object class="wxComboBox" name="ID_BLEND_MODE">
                            <style>wxCB_READONLY</style>
                        </object>
                    </object>
                </object>
            </object>

            <!-- 3. ENVELOPPE AJOUTÉE : Opacité -->
            <object class="sizeritem">
                <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
                <border>8</border>
                <object class="wxStaticBoxSizer">
                    <orient>wxVERTICAL</orient>
                    <label>Opacité</label>
                    <object class="sizeritem">
                        <flag>wxEXPAND</flag>
                        <object class="wxBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                                <flag>wxEXPAND|wxRIGHT</flag>
                                <border>10</border>
                                <proportion>1</proportion>
                                <object class="wxSlider" name="ID_OPACITY_SLIDER">
                                    <value>100</value>
                                    <min>0</min>
                                    <max>100</max>
                                    <style>wxSL_HORIZONTAL|wxSL_AUTOTICKS</style>
                                </object>
                            </object>
                            <object class="sizeritem">
                                <flag>wxALIGN_CENTER_VERTICAL</flag>
                                <object class="wxStaticText" name="ID_OPACITY_VALUE">
                                    <label>100 %</label>
                                    <size>50,-1</size>
                                    <style>wxALIGN_RIGHT</style>
                                </object>
                            </object>
                        </object>
                    </object>
                </object>
            </object>

            <!-- 4. ENVELOPPE AJOUTÉE : Boutons standards -->
            <object class="sizeritem">
                <flag>wxEXPAND|wxALL</flag>
                <border>8</border>
                <object class="wxStdDialogButtonSizer">
                    <object class="button">
                        <object class="wxButton" name="wxID_CANCEL">
                            <label>Annuler</label>
                        </object>
                    </object>
                    <object class="button">
                        <object class="wxButton" name="wxID_OK">
                            <label>OK</label>
                            <default>1</default>
                        </object>
                    </object>
                </object>
            </object>

        </object>
    </object>
</resource>

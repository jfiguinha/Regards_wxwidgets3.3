<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<resource xmlns="http://wxwidgets.org">
	<object class="wxDialog" name="ResizeDialog">
		<style>wxDEFAULT_DIALOG_STYLE</style>
		<title>Redimensionner l'image</title>
		
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			
			<!-- 1. Gestion des Onglets -->
			<object class="sizeritem">
				<option>1</option>
				<flag>wxEXPAND | wxALL</flag>
				<border>10</border>
				<object class="wxNotebook" name="m_notebook">
					
					<!-- Onglet : Taille Réelle (Pixels) -->
					<object class="notebookpage">
						<label>Taille réelle (Pixels)</label>
						<object class="wxPanel" name="pixelPanel">
							<object class="wxBoxSizer">
								<orient>wxVERTICAL</orient>
								<object class="sizeritem">
									<option>1</option>
									<flag>wxEXPAND | wxALL</flag>
									<border>15</border>
									<object class="wxFlexGridSizer">
										<rows>2</rows>
										<cols>2</cols>
										<vgap>10</vgap>
										<hgap>10</hgap>
										
										<object class="sizeritem">
											<flag>wxALIGN_CENTER_VERTICAL</flag>
											<object class="wxStaticText">
												<label>Largeur (px) :</label>
											</object>
										</object>
										<object class="sizeritem">
											<option>1</option>
											<flag>wxEXPAND</flag>
											<object class="wxSpinCtrl" name="m_spinPixelWidth">
												<value>100</value>
												<min>1</min>
												<max>10000</max>
											</object>
										</object>
										
										<object class="sizeritem">
											<flag>wxALIGN_CENTER_VERTICAL</flag>
											<object class="wxStaticText">
												<label>Hauteur (px) :</label>
											</object>
										</object>
										<object class="sizeritem">
											<option>1</option>
											<flag>wxEXPAND</flag>
											<object class="wxSpinCtrl" name="m_spinPixelHeight">
												<value>100</value>
												<min>1</min>
												<max>10000</max>
											</object>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
					
					<!-- Onglet : En Pourcentage -->
					<object class="notebookpage">
						<label>En pourcentage</label>
						<object class="wxPanel" name="percentPanel">
							<object class="wxBoxSizer">
								<orient>wxVERTICAL</orient>
								<object class="sizeritem">
									<option>1</option>
									<flag>wxEXPAND | wxALL</flag>
									<border>15</border>
									<object class="wxFlexGridSizer">
										<rows>2</rows>
										<cols>2</cols>
										<vgap>10</vgap>
										<hgap>10</hgap>
										
										<object class="sizeritem">
											<flag>wxALIGN_CENTER_VERTICAL</flag>
											<object class="wxStaticText">
												<label>Largeur (%) :</label>
											</object>
										</object>
										<object class="sizeritem">
											<option>1</option>
											<flag>wxEXPAND</flag>
											<object class="wxSpinCtrl" name="m_spinPercentWidth">
												<value>100</value>
												<min>1</min>
												<max>1000</max>
											</object>
										</object>
										
										<object class="sizeritem">
											<flag>wxALIGN_CENTER_VERTICAL</flag>
											<object class="wxStaticText">
												<label>Hauteur (%) :</label>
											</object>
										</object>
										<object class="sizeritem">
											<option>1</option>
											<flag>wxEXPAND</flag>
											<object class="wxSpinCtrl" name="m_spinPercentHeight">
												<value>100</value>
												<min>1</min>
												<max>1000</max>
											</object>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
					
				</object>
			</object>
			
			<!-- 2. Case à cocher : Conserver Proportions -->
			<object class="sizeritem">
				<flag>wxLEFT | wxRIGHT | wxBOTTOM</flag>
				<border>15</border>
				<object class="wxCheckBox" name="m_checkKeepRatio">
					<label>Conserver les proportions (Ratio)</label>
					<checked>1</checked>
				</object>
			</object>
			
			<!-- 3. ComboBox : Méthode d'Interpolation -->
			<object class="sizeritem">
				<flag>wxLEFT | wxRIGHT | wxBOTTOM | wxEXPAND</flag>
				<border>15</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					
					<object class="sizeritem">
						<flag>wxALIGN_CENTER_VERTICAL | wxRIGHT</flag>
						<border>10</border>
						<object class="wxStaticText">
							<label>Qualité / Interpolation :</label>
						</object>
					</object>
					
					<object class="sizeritem">
						<option>1</option>
						<flag>wxEXPAND</flag>
						<object class="wxComboBox" name="m_comboInterpolation">
							<style>wxCB_READONLY</style>
								<content>
									<item>NEAREST</item>
									<item>LINEAR</item>
									<item>CUBIC</item>
									<item>AREA</item>
									<item>LANCZOS4</item>
									<item>LINEAR_EXACT</item>
									<item>NEAREST_EXACT</item>
									<item>AVIR</item>
									<item>BboxFilter</item>
									<item>HermiteFilter</item>
									<item>HanningFilter</item>
									<item>CatromFilter</item>
									<item>MitchellFilter</item>
									<item>TriangleFilter</item>
									<item>QuadraticFilter</item>
									<item>BlackmanFilter</item>
									<item>HammingFilter</item>
								</content>
							<selection>1</selection>
						</object>
					</object>
				</object>
			</object>
			
			<!-- 4. Boutons standard OK / Annuler -->
			<object class="sizeritem">
				<flag>wxALIGN_RIGHT | wxBOTTOM | wxRIGHT</flag>
				<border>10</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Annuler</label>
						</object>
					</object>
				</object>
			</object>
			
		</object>
	</object>
</resource>

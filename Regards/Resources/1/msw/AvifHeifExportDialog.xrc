<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://wxwidgets.org">
<object class="wxDialog" name="AvifHeifExportDialog">
    <title>AVIF / HEIF Export</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>
    <size>850,700</size>
    <object class="wxBoxSizer">
        <orient>wxVERTICAL</orient>
        
        <!-- Informations image -->
        <object class="sizeritem">
            <flag>wxEXPAND|wxALL</flag>
            <border>10</border>
            <object class="wxStaticText" name="imageInfo">
                <label>Original Information</label>
            </object>
        </object>
        
        <!-- Prévisualisations -->
        <object class="sizeritem">
            <option>1</option>
            <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
            <border>5</border>
            <object class="wxBoxSizer">
                <orient>wxHORIZONTAL</orient>
                <!-- Image originale -->
                <object class="sizeritem">
                    <option>1</option>
                    <flag>wxEXPAND|wxALL</flag>
                    <border>5</border>
                    <object class="wxStaticBoxSizer">
                        <label>Original Picture</label>
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                            <option>1</option>
                            <flag>wxEXPAND|wxALL</flag>
                            <border>5</border>
                            <object class="wxPanel" name="originalPreviewPanel">
                                <style>wxBORDER_SIMPLE</style>
                                <size>350,350</size>
                            </object>
                        </object>
                        <object class="sizeritem">
                            <flag>wxALIGN_CENTER|wxALL</flag>
                            <border>5</border>
                            <object class="wxStaticText" name="originalSize">
                                <label>Size</label>
                            </object>
                        </object>
                    </object>
                </object>
                <!-- Image Compressée -->
                <object class="sizeritem">
                    <option>1</option>
                    <flag>wxEXPAND|wxALL</flag>
                    <border>5</border>
                    <object class="wxStaticBoxSizer">
                        <label>Compressed Preview</label>
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                            <option>1</option>
                            <flag>wxEXPAND|wxALL</flag>
                            <border>5</border>
                            <object class="wxPanel" name="compressedPreviewPanel">
                                <style>wxBORDER_SIMPLE</style>
                                <size>350,350</size>
                            </object>
                        </object>
                        <object class="sizeritem">
                            <flag>wxALIGN_CENTER|wxALL</flag>
                            <border>5</border>
                            <object class="wxStaticText" name="compressedSize">
                                <label>Compressed Size</label>
                            </object>
                        </object>
                    </object>
                </object>
            </object>
        </object>	
        <!-- Paramètres d'encodage (Qualité & Vitesse) -->
        <object class="sizeritem">
            <flag>wxEXPAND|wxALL</flag>
            <border>10</border>
            <object class="wxStaticBoxSizer">
                <label>Encoder Settings</label>
                <orient>wxVERTICAL</orient>
                
                <!-- Qualité -->
                <object class="sizeritem">
                    <flag>wxALL</flag>
                    <border>5</border>
                    <object class="wxStaticText" name="qualityLabel">
                        <label>Quality : 75 %</label>
                    </object>
                </object>
                <object class="sizeritem">
                    <flag>wxEXPAND|wxALL</flag>
                    <border>5</border>
                    <object class="wxSlider" name="qualitySlider">
                        <value>75</value>
                        <min>1</min>
                        <max>100</max>
                        <style>wxSL_HORIZONTAL</style>
                    </object>
                </object>

                <!-- Vitesse / Effort d'encodage -->
                <object class="sizeritem">
                    <flag>wxALL</flag>
                    <border>5</border>
                    <object class="wxStaticText" name="speedLabel">
                        <label>Encoding Effort (Speed) : 6</label>
                    </object>
                </object>
                <object class="sizeritem">
                    <flag>wxEXPAND|wxALL</flag>
                    <border>5</border>
                    <object class="wxSlider" name="speedSlider">
                        <value>6</value>
                        <min>0</min>
                        <max>10</max>
                        <style>wxSL_HORIZONTAL</style>
                    </object>
                </object>
            </object>
        </object>

        <!-- Boutons de validation -->
        <object class="sizeritem">
            <flag>wxALIGN_RIGHT|wxALL</flag>
            <border>10</border>
            <object class="wxStdDialogButtonSizer">
                <object class="button">
                    <object class="wxButton" name="wxID_OK">
                        <label>Ok</label>
                    </object>
                </object>
                <object class="button">
                    <object class="wxButton" name="wxID_CANCEL">
                        <label>Cancel</label>
                    </object>
                </object>
            </object>
        </object>
    </object>
</object>
</resource>

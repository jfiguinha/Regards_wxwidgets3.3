<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<resource xmlns="http://wxwidgets.org">
	<object class="wxDialog" name="OpenDialog">
		<style>wxDEFAULT_DIALOG_STYLE</style>
		<title>New Picture</title>
		
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			
			<!-- 1. Gestion des Onglets -->
			<object class="sizeritem">
				<option>1</option>
				<flag>wxEXPAND | wxALL</flag>
				<border>10</border>
				<object class="wxNotebook" name="m_notebook">
					
					<!-- Onglet : Taille Réelle (Pixels) -->
					<object class="notebookpage">
						<label>Pixel Size</label>
						<object class="wxPanel" name="pixelPanel">
							<object class="wxBoxSizer">
								<orient>wxVERTICAL</orient>
								<object class="sizeritem">
									<option>1</option>
									<flag>wxEXPAND | wxALL</flag>
									<border>15</border>
									<object class="wxFlexGridSizer">
										<rows>2</rows>
										<cols>2</cols>
										<vgap>10</vgap>
										<hgap>10</hgap>
										
										<object class="sizeritem">
											<flag>wxALIGN_CENTER_VERTICAL</flag>
											<object class="wxStaticText">
												<label>Width (px) :</label>
											</object>
										</object>
										<object class="sizeritem">
											<option>1</option>
											<flag>wxEXPAND</flag>
											<object class="wxSpinCtrl" name="m_spinPixelWidth">
												<value>100</value>
												<min>1</min>
												<max>10000</max>
											</object>
										</object>
										
										<object class="sizeritem">
											<flag>wxALIGN_CENTER_VERTICAL</flag>
											<object class="wxStaticText">
												<label>Height (px) :</label>
											</object>
										</object>
										<object class="sizeritem">
											<option>1</option>
											<flag>wxEXPAND</flag>
											<object class="wxSpinCtrl" name="m_spinPixelHeight">
												<value>100</value>
												<min>1</min>
												<max>10000</max>
											</object>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			
			<!-- 4. Boutons standard OK / Annuler -->
			<object class="sizeritem">
				<flag>wxALIGN_RIGHT | wxBOTTOM | wxRIGHT</flag>
				<border>10</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Cancel</label>
						</object>
					</object>
				</object>
			</object>
			
		</object>
	</object>
</resource>

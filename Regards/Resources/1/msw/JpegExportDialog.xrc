<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc">
<object class="wxDialog" name="JpegExportDialog">
    <title>JPEG Export</title>
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>
    <size>850,650</size>
    <object class="wxBoxSizer">
        <orient>wxVERTICAL</orient>
        <!-- Informations image -->
        <object class="sizeritem">
            <flag>wxEXPAND|wxALL</flag>
                <border>10</border>
            <object class="wxStaticText" name="imageInfo">
                    <label>Original</label>
                </object>
        </object>
        <!-- Prévisualisations -->
        <object class="sizeritem">
            <option>1</option>
                <flag>wxEXPAND|wxLEFT|wxRIGHT</flag>
                <border>5</border>
            <object class="wxBoxSizer">
                <orient>wxHORIZONTAL</orient>
                <!-- Image originale -->
                <object class="sizeritem">
                    <option>1</option>
                        <flag>wxEXPAND|wxALL</flag>
                        <border>5</border>
                    <object class="wxStaticBoxSizer">
                        <label>Original Picture</label>
                            <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                            <option>1</option>
                                <flag>wxEXPAND|wxALL</flag>
                                <border>5</border>
                            <object class="wxPanel" name="originalPreviewPanel">
                                <style>wxBORDER_SIMPLE</style>
                                <size>350,350</size>
                            </object>
                        </object>
                        <object class="sizeritem">
                            <flag>wxALIGN_CENTER|wxALL</flag>
                                <border>5</border>
                            <object class="wxStaticText" name="originalSize">
                                    <label>Size</label>
                                </object>
                        </object>
                    </object>
                </object>
                <!-- Image JPEG -->
                <object class="sizeritem">
                    <option>1</option>
                        <flag>wxEXPAND|wxALL</flag>
                        <border>5</border>
                    <object class="wxStaticBoxSizer">
                        <label>JPEG Preview</label>
                            <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                            <option>1</option>
                                <flag>wxEXPAND|wxALL</flag>
                                <border>5</border>
                            <object class="wxPanel" name="jpegPreviewPanel">
                                <style>wxBORDER_SIMPLE</style>
                                <size>350,350</size>
                            </object>
                        </object>
                        <object class="sizeritem">
                            <flag>wxALIGN_CENTER|wxALL</flag>
                                <border>5</border>
                            <object class="wxStaticText" name="jpegSize">
                                    <label>JPEG Size</label>
                                </object>
                        </object>
                    </object>
                </object>
            </object>
        </object>
        <!-- Qualité -->
		<object class="sizeritem">
            <flag>wxEXPAND|wxALL</flag>
            <border>10</border>
            <option>0</option>
            <object class="wxRadioBox" name="ID_RBCODEC">
                <label>Codec Option</label>
                <style>wxRA_SPECIFY_COLS</style>
                <dimension>3</dimension>
                <content>
                    <item>Baseline</item>
                    <item>Arithmetic</item>
                    <item>Grayscale</item>
                    <item>Optimize</item>
                    <item>Progressive</item>
                    <item>Lossless</item>
                    <item>Smoothing</item>
                    <item>Subsample_422</item>
                    <item>Subsample_444</item>
                </content>
                <default>-1</default>
            </object>
        </object>
		
        <object class="sizeritem">
            <flag>wxEXPAND|wxALL</flag>
                <border>10</border>
            <object class="wxStaticBoxSizer">
                <label>JPEG Quality</label>
                    <orient>wxVERTICAL</orient>
                <object class="sizeritem">
                    <flag>wxALL</flag>
                        <border>5</border>
                    <object class="wxStaticText" name="qualityLabel">
                            <label>Quality : 90 %</label>
                        </object>
                </object>
                <object class="sizeritem">
                    <flag>wxEXPAND|wxALL</flag>
                        <border>5</border>
                    <object class="wxSlider" name="qualitySlider">
                        <value>90</value>
                            <min>1</min>
                            <max>100</max>
                        <style>wxSL_HORIZONTAL|wxSL_LABELS</style>
                    </object>
                </object>
            </object>
        </object>
        <!-- Boutons -->
        <object class="sizeritem">
            <flag>wxALIGN_RIGHT|wxALL</flag>
                <border>10</border>
            <object class="wxStdDialogButtonSizer">
                <object class="button">
                    <object class="wxButton" name="wxID_OK">
                        <label>Ok</label>
                    </object>
                </object>
                <object class="button">
                    <object class="wxButton" name="wxID_CANCEL">
                        <label>Cancel</label>
                    </object>
                </object>
            </object>
        </object>
    </object>
</object>
</resource>
